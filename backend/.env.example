DB_USER=postgres
DB_PASSWORD=password123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexo_radar

# Clave Maestra de Seguridad
MASTER_PASSWORD=nexo2026

# Notificaciones Web Push (VAPID)
