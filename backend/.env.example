# ----------------------------------------------------------------------
# CLOUDINARY (Indispensable en Producción / Render)
# Sin esto, las imágenes se guardan en disco local y se pierden al reiniciar
# ----------------------------------------------------------------------
# Opción A (Recomendada): La URL completa que da Cloudinary en el Dashboard
CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>

# Opción B: Variables individuales (si prefieres separarlas en Render)
# CLOUDINARY_CLOUD_NAME=tu_cloud_name
# CLOUDINARY_API_KEY=tu_api_key
# CLOUDINARY_API_SECRET=tu_api_secret
